@model PermitManagmentSystem.Models.DTOs.AssignTaskDto
@{
    Layout = "~/Views/Shared/_DepartmentLayout.cshtml";
    ViewBag.Title = Model.IsEdit ? "Edit work" : "Assign work";
}

<a class="back" href="@Url.Action("Permits", "Department")">&larr; Back to permits</a>

<div class="page-head">
    <div>
        <h1>@(Model.IsEdit ? "Edit work" : "Assign work")</h1>
        <p>Permit @Model.PermitNo</p>
    </div>
</div>

@using (Html.BeginForm("Assign", "Department", FormMethod.Post, new { novalidate = "novalidate" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.PermitId)

    <div class="form-shell">
        <aside class="form-aside">
            <h2>@(Model.IsEdit ? "Update the work" : "Open the task")</h2>
            <p>Record who supervises the job, when it starts and is expected to finish, and the pass number of every worker involved.</p>
            <ul>
                <li>One supervisor per permit</li>
                <li>Add one pass no per worker</li>
                <li>You can come back and edit later</li>
            </ul>
        </aside>

        <div class="form-main">
            <section class="fsec">
                <h3>Permit details</h3>
                <p class="fsub">Issued by Operation. Read only.</p>
                <dl class="info">
                    <div>
                    <dt>Permit no</dt>
                    <dd>@Model.PermitNo</dd>
        </div>
        <div><dt>Issue date</dt><dd>@Model.IssueDate.ToString("dd MMM yyyy")</dd></div>
        <div><dt>Work location</dt><dd>@Model.WorkLocation</dd></div>
        <div><dt>Department</dt><dd>@Model.DepartmentName</dd></div>
        <div><dt>Permit issued by</dt><dd>@Model.PermitIssueBy</dd></div>
        <div><dt>Permit issued to</dt><dd>@Model.PermitIssueTo</dd></div>
        <div class="full"><dt>Description</dt><dd>@Model.Description</dd></div>
        <div class="full">
            <dt>Document</dt>
            <dd>
                @if (Model.AttachmentFileName != null)
                {
                    <a class="file" href="@Url.Action("Download", "Department", new { id = Model.PermitId })">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5" /></svg>
                        <span>@Model.AttachmentFileName</span>
                    </a>
                }
                else
                {
                    <span class="muted">No document attached</span>
                }
            </dd>
        </div>
        </dl>
        </section>

        <section class="fsec">
            <h3>Work assignment</h3>
            <p class="fsub">Who is in charge and the work dates.</p>

            @Html.ValidationSummary(true, "", new { @class = "alert" })

            <div class="fields">
                <div class="f">
                    @Html.LabelFor(m => m.WorkStartDate)
                    @Html.TextBoxFor(m => m.WorkStartDate, "{0:yyyy-MM-dd}", new { type = "date" })
                    @Html.ValidationMessageFor(m => m.WorkStartDate, "", new { @class = "err" })
                </div>
                <div class="f">
                    @Html.LabelFor(m => m.ExpectedEndDate)
                    @Html.TextBoxFor(m => m.ExpectedEndDate, "{0:yyyy-MM-dd}", new { type = "date" })
                    @Html.ValidationMessageFor(m => m.ExpectedEndDate, "", new { @class = "err" })
                </div>
                <div class="f full">
                    @Html.LabelFor(m => m.SupervisorName)
                    @Html.TextBoxFor(m => m.SupervisorName, new { maxlength = 150, autocomplete = "off" })
                    @Html.ValidationMessageFor(m => m.SupervisorName, "", new { @class = "err" })
                </div>
            </div>
        </section>

        <section class="fsec">
            <h3>Workers involved</h3>
            <p class="fsub">Enter the pass no of each worker. Use Add worker for more.</p>

            <div class="f">
                <div id="workers" class="worker-list">
                    @foreach (var pass in Model.WorkerPassNos)
                    {
                        <div class="worker-row">
                            <input type="text" name="WorkerPassNos" value="@pass" maxlength="50" placeholder="Worker pass no" aria-label="Worker pass no" autocomplete="off" />
                            <button type="button" class="act-btn danger rm">Remove</button>
                        </div>
                    }
                </div>
                @Html.ValidationMessage("WorkerPassNos", "", new { @class = "err" })
                <button type="button" id="addWorker" class="btn btn-ghost add-worker">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                    Add worker
                </button>
            </div>
        </section>

        <div class="form-actions">
            <a class="btn btn-ghost" href="@Url.Action("Permits", "Department")">Cancel</a>
            <button type="submit" class="btn">Save</button>
        </div>
    </div>
    </div>
}

@section Scripts {
    <script>
        (function () {
            var list = document.getElementById('workers');
            var addBtn = document.getElementById('addWorker');

            function addRow(focus) {
                var row = document.createElement('div');
                row.className = 'worker-row';
                row.innerHTML =
                    '<input type="text" name="WorkerPassNos" maxlength="50" placeholder="Worker pass no" aria-label="Worker pass no" autocomplete="off" />' +
                    '<button type="button" class="act-btn danger rm">Remove</button>';
                list.appendChild(row);
                if (focus) row.querySelector('input').focus();
            }

            addBtn.addEventListener('click', function () { addRow(true); });

            list.addEventListener('click', function (e) {
                if (!e.target.classList.contains('rm')) return;
                var rows = list.querySelectorAll('.worker-row');
                var row = e.target.closest('.worker-row');
                if (rows.length === 1) { row.querySelector('input').value = ''; row.querySelector('input').focus(); }
                else { list.removeChild(row); }
            });

            // Enter adds the next worker instead of submitting the form
            list.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' && e.target.name === 'WorkerPassNos') {
                    e.preventDefault();
                    addRow(true);
                }
            });
        })();
    </script>
}
