@model PermitManagmentSystem.Models.DTOs.AssignTaskDto
@{
    Layout = "~/Views/Shared/_DepartmentLayout.cshtml";
    ViewBag.Title = Model.IsLocked ? "Work details" : (Model.IsEdit ? "Edit work" : "Assign work");
}

@helper PermitDetails(PermitManagmentSystem.Models.DTOs.AssignTaskDto m)
{
    <section class="fsec">
        <h3>Permit details</h3>
        <p class="fsub">Issued by Operation. Read only.</p>
        <dl class="info">
            <div>
            <dt>Permit no</dt>
            <dd>@m.PermitNo</dd></div>
            <div>
            <dt>Issue date</dt>
            <dd>@m.IssueDate.ToString("dd MMM yyyy")</dd></div>
            <div>
            <dt>Work location</dt>
            <dd>@m.WorkLocation</dd></div>
            <div>
            <dt>Department</dt>
            <dd>@m.DepartmentName</dd></div>
            <div>
            <dt>Permit issued by</dt>
            <dd>@m.PermitIssueBy</dd></div>
            <div>
            <dt>Permit issued to</dt>
            <dd>@m.PermitIssueTo</dd></div>
            <div class="full">
            <dt>Description</dt>
            <dd>@m.Description</dd></div>
            <div class="full">
            <dt>Document</dt>
            <dd>
                @if (m.AttachmentFileName != null)
                {
                    <a class="file" href="@Url.Action("Download", "Department", new { id = m.PermitId })">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5" /></svg>
                        <span>@m.AttachmentFileName</span>
                    </a>
                }
                else
                {
                    <span class="muted">No document attached</span>
                }
            </dd>
            </div>
        </dl>
    </section>
}

<a class="back" href="@Url.Action("Permits", "Department")">&larr; Back to permits</a>

<div class="page-head">
    <div>
        <h1>@(Model.IsLocked ? "Work details" : (Model.IsEdit ? "Edit work" : "Assign work"))</h1>
        <p>Permit @Model.PermitNo</p>
    </div>
</div>

@if (Model.IsLocked)
{
    <div class="form-shell">
        <aside class="form-aside">
            <h2>Safety Steward assigned</h2>
            <p>Safety has assigned a steward to this job, so the work is locked. You can review the details below and close the job when it is finished.</p>
            <ul>
                <li>The work can no longer be edited</li>
                <li>Contact the steward on the mobile no shown</li>
                <li>Close the job when the work is done</li>
            </ul>
        </aside>

        <div class="form-main">
            @PermitDetails(Model)

            <section class="fsec">
                <h3>Work assignment</h3>
                <p class="fsub">Set up by your department. Read only.</p>
                <dl class="info">
                    <div>
                    <dt>Supervisor</dt>
                    <dd>@Model.SupervisorName</dd>
        </div>
        <div>
            <dt>Work dates</dt>
            <dd>
                @(Model.WorkStartDate.HasValue ? Model.WorkStartDate.Value.ToString("dd MMM yyyy") : "")
                &ndash;
                @(Model.ExpectedEndDate.HasValue ? Model.ExpectedEndDate.Value.ToString("dd MMM yyyy") : "")
            </dd>
        </div>
        <div class="full">
            <dt>Workers (pass no &ndash; name)</dt>
            <dd>
                <div class="chips">
                    @foreach (var w in Model.Workers)
                    {
                        <span class="chip">@w.PassNo@(string.IsNullOrEmpty(w.WorkerName) ? "" : " – " + w.WorkerName)</span>
                    }
                </div>
            </dd>
        </div>
        </dl>
        </section>

        <section class="fsec">
            <h3>Safety Steward</h3>
            <p class="fsub">Assigned by the Safety department.</p>
            <dl class="info">
                <div>
                <dt>Steward name</dt>
                <dd>@Model.SafetyStewardName</dd>
    </div>
    <div>
        <dt>Mobile no</dt>
        <dd>
            @if (!string.IsNullOrEmpty(Model.SafetyStewardMobile))
            {
                <a href="tel:@Model.SafetyStewardMobile">@Model.SafetyStewardMobile</a>
            }
            else
            {
                <span class="muted">Not added</span>
            }
        </dd>
    </div>
    </dl>
    </section>

    <div class="form-actions">
        <a class="btn btn-ghost" href="@Url.Action("Permits", "Department")">Back</a>
        @using (Html.BeginForm("Close", "Department", FormMethod.Post, new { @class = "inline-form", onsubmit = "return confirm('Close this permit? It cannot be edited after closing.');" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.PermitId" />
            <input type="hidden" name="returnTo" value="permits" />
            <button type="submit" class="btn btn-danger">Close job</button>
        }
    </div>
    </div>
    </div>
}
else
{
    using (Html.BeginForm("Assign", "Department", FormMethod.Post, new { novalidate = "novalidate" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.PermitId)

        <div class="form-shell">
            <aside class="form-aside">
                <h2>@(Model.IsEdit ? "Update the work" : "Open the task")</h2>
                <p>Record who supervises the job, when it starts and is expected to finish, and the pass number and name of every worker involved.</p>
                <ul>
                    <li>One supervisor per permit</li>
                    <li>Add one pass no and name per worker</li>
                    <li>You can edit until Safety assigns a steward</li>
                </ul>
            </aside>

            <div class="form-main">
                @PermitDetails(Model)

                <section class="fsec">
                    <h3>Work assignment</h3>
                    <p class="fsub">Who is in charge and the work dates.</p>

                    @Html.ValidationSummary(true, "", new { @class = "alert" })

                    <div class="fields">
                        <div class="f">
                            @Html.LabelFor(m => m.WorkStartDate)
                            @Html.TextBoxFor(m => m.WorkStartDate, "{0:yyyy-MM-dd}", new { type = "date" })
                            @Html.ValidationMessageFor(m => m.WorkStartDate, "", new { @class = "err" })
                        </div>
                        <div class="f">
                            @Html.LabelFor(m => m.ExpectedEndDate)
                            @Html.TextBoxFor(m => m.ExpectedEndDate, "{0:yyyy-MM-dd}", new { type = "date" })
                            @Html.ValidationMessageFor(m => m.ExpectedEndDate, "", new { @class = "err" })
                        </div>
                        <div class="f full">
                            @Html.LabelFor(m => m.SupervisorName)
                            @Html.TextBoxFor(m => m.SupervisorName, new { maxlength = 150, autocomplete = "off" })
                            @Html.ValidationMessageFor(m => m.SupervisorName, "", new { @class = "err" })
                        </div>
                    </div>
                </section>

                <section class="fsec">
                    <h3>Workers involved</h3>
                    <p class="fsub">Enter the pass no and name of each worker. Use Add worker for more.</p>

                    <div class="f">
                        <div id="workers" class="worker-list">
                            @for (var i = 0; i < Model.Workers.Count; i++)
                            {
                                <div class="worker-row">
                                    <input type="text" class="w-pass" name="Workers[@i].PassNo" value="@Model.Workers[i].PassNo" maxlength="50" placeholder="Pass no" aria-label="Worker pass no" autocomplete="off" />
                                    <input type="text" class="w-name" name="Workers[@i].WorkerName" value="@Model.Workers[i].WorkerName" maxlength="150" placeholder="Worker name" aria-label="Worker name" autocomplete="off" />
                                    <button type="button" class="act-btn danger rm">Remove</button>
                                </div>
                            }
                        </div>
                        @Html.ValidationMessage("Workers", "", new { @class = "err" })
                        <button type="button" id="addWorker" class="btn btn-ghost add-worker">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                            Add worker
                        </button>
                    </div>
                </section>

                <div class="form-actions">
                    <a class="btn btn-ghost" href="@Url.Action("Permits", "Department")">Cancel</a>
                    <button type="submit" class="btn">Save</button>
                </div>
            </div>
        </div>
    }
}

@section Scripts {
    @if (!Model.IsLocked)
    {
        <script>
            (function () {
                var list = document.getElementById('workers');
                var addBtn = document.getElementById('addWorker');

                // keep Workers[0], Workers[1]... in order so MVC binds the list
                function reindex() {
                    var rows = list.querySelectorAll('.worker-row');
                    for (var i = 0; i < rows.length; i++) {
                        rows[i].querySelector('.w-pass').name = 'Workers[' + i + '].PassNo';
                        rows[i].querySelector('.w-name').name = 'Workers[' + i + '].WorkerName';
                    }
                }

                function addRow(focus) {
                    var row = document.createElement('div');
                    row.className = 'worker-row';
                    row.innerHTML =
                        '<input type="text" class="w-pass" maxlength="50" placeholder="Pass no" aria-label="Worker pass no" autocomplete="off" />' +
                        '<input type="text" class="w-name" maxlength="150" placeholder="Worker name" aria-label="Worker name" autocomplete="off" />' +
                        '<button type="button" class="act-btn danger rm">Remove</button>';
                    list.appendChild(row);
                    reindex();
                    if (focus) row.querySelector('.w-pass').focus();
                }

                addBtn.addEventListener('click', function () { addRow(true); });

                list.addEventListener('click', function (e) {
                    if (!e.target.classList.contains('rm')) return;
                    var rows = list.querySelectorAll('.worker-row');
                    var row = e.target.closest('.worker-row');
                    if (rows.length === 1) {
                        row.querySelector('.w-pass').value = '';
                        row.querySelector('.w-name').value = '';
                        row.querySelector('.w-pass').focus();
                    } else {
                        list.removeChild(row);
                        reindex();
                    }
                });

                // Enter in pass no moves to name; Enter in name adds the next worker
                list.addEventListener('keydown', function (e) {
                    if (e.key !== 'Enter') return;
                    if (e.target.classList.contains('w-pass')) {
                        e.preventDefault();
                        e.target.closest('.worker-row').querySelector('.w-name').focus();
                    } else if (e.target.classList.contains('w-name')) {
                        e.preventDefault();
                        addRow(true);
                    }
                });

                reindex();
            })();
        </script>
    }
}