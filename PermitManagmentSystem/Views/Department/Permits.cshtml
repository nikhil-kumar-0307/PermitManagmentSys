@model PermitManagmentSystem.Models.DTOs.DepartmentPermitListDto
@{
    Layout = "~/Views/Shared/_DepartmentLayout.cshtml";
    ViewBag.Title = "Permits";
}

<div class="page-head">
    <div>
        <h1>Permits</h1>
        <p>Permits issued by Operation to your department.</p>
    </div>
</div>

<form class="toolbar" method="get" action="@Url.Action("Permits", "Department")">
    <div class="search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
        <input type="search" name="q" value="@Model.Query" placeholder="Search permit no, location, description or name" aria-label="Search permits" />
    </div>
    <div class="size-pick">
        <label for="status">Status</label>
        <select id="status" name="status" onchange="this.form.submit()">
            <option value="" selected="@(string.IsNullOrEmpty(Model.Status))">All</option>
            <option value="pending" selected="@(Model.Status == "pending")">Awaiting assignment</option>
            <option value="safety" selected="@(Model.Status == "safety")">With Safety</option>
            <option value="ready" selected="@(Model.Status == "ready")">Ready to close</option>
            <option value="closing" selected="@(Model.Status == "closing")">With Safety for final close</option>
            <option value="closed" selected="@(Model.Status == "closed")">Closed</option>
        </select>
    </div>
    <button class="btn" type="submit">Search</button>
</form>

@if (!Model.Items.Any())
{
    <div class="table-wrap">
        <div class="empty">
            <h2>No permits found</h2>
            <p>Try a different search or status.</p>
        </div>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="table-fixed cards">
            <colgroup>
                <col style="width:11%" />
                <col style="width:16%" />
                <col style="width:11%" />
                <col style="width:15%" />
                <col style="width:17%" />
                <col style="width:11%" />
                <col style="width:19%" />
            </colgroup>
            <thead>
                <tr><th>Permit no</th><th>Work location</th><th>Date</th><th>Status</th><th>Safety Steward</th><th>Expected end</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Items)
                {
                    <tr>
                        <td class="no" data-label="Permit no">
                            @if (p.Stage == "closed" || p.Stage == "closing")
                            {
                                @p.PermitNo
                            }
                            else
                            {
                                <a href="@Url.Action("Assign", "Department", new { id = p.Id })">@p.PermitNo</a>
                            }
                        </td>
                        <td data-label="Work location">@p.WorkLocation</td>
                        <td class="date" data-label="Date">@p.IssueDate.ToString("dd MMM yyyy")</td>
                        <td data-label="Status">
                            @if (p.Stage == "pending")
                            {
                                <span class="pill none">Awaiting assignment</span>
                            }
                            else if (p.Stage == "safety")
                            {
                                <span class="pill wait">With Safety</span>
                            }
                            else if (p.Stage == "ready")
                            {
                                <span class="pill ok">Ready to close</span>
                            }
                            else if (p.Stage == "closing")
                            {
                                <span class="pill wait">With Safety for final close</span>
                            }
                            else
                            {
                                <span class="pill closed">Closed</span>
                            }
                        </td>
                        <td data-label="Safety Steward">
                            @if (!string.IsNullOrEmpty(p.SafetyStewardName))
                            {
                                <div>
                                    <strong>@p.SafetyStewardName</strong>
                                    @if (!string.IsNullOrEmpty(p.SafetyStewardMobile))
                                    {
                                        <div class="muted">@p.SafetyStewardMobile</div>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="muted">&mdash;</span>
                            }
                        </td>
                        <td class="date" data-label="Expected end">
                            @if (p.ExpectedEndDate.HasValue)
                            {
                                @p.ExpectedEndDate.Value.ToString("dd MMM yyyy")
                            }
                            else
                            {
                                <span class="muted">&mdash;</span>
                            }
                        </td>
                        <td class="act">
                            @if (p.Stage == "pending")
                            {
                                <a class="act-btn" href="@Url.Action("Assign", "Department", new { id = p.Id })">Assign work</a>
                            }
                            else if (p.Stage == "safety")
                            {
                                <a class="act-btn" href="@Url.Action("Assign", "Department", new { id = p.Id })">View / edit</a>
                            }
                            else if (p.Stage == "ready")
                            {
                                <a class="act-btn" href="@Url.Action("Assign", "Department", new { id = p.Id })">View</a>
                                using (Html.BeginForm("Close", "Department", FormMethod.Post, new { @class = "inline-form", onsubmit = "return confirm('Close this permit? It cannot be edited after closing.');" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@p.Id" />
                                    <input type="hidden" name="returnTo" value="permits" />
                                    <button type="submit" class="act-btn danger">Close job</button>
                                }
                            }
                            else if (p.Stage == "closing")
                            {
                                <span class="muted">Closed @(p.ClosedOn.HasValue ? p.ClosedOn.Value.ToString("dd MMM yyyy") : ""). Waiting for Safety.</span>
                            }
                            else
                            {
                                <span class="muted">Final closed @(p.FinalClosedOn.HasValue ? p.FinalClosedOn.Value.ToString("dd MMM yyyy") : "")</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="hint">Showing the latest @Model.Items.Count permits. Use search to narrow the list.</p>
}