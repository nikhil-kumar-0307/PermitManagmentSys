@model PermitManagmentSystem.Models.DTOs.LoginDto
@{
    Layout = null;
    ViewBag.Title = "Sign in";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - Permit Management</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --ink: #0f172a;
            --navy: #0f1b33;
            --navy-deep: #0a1325;
            --accent: #2563eb;
            --accent-dark: #1d4ed8;
            --field: #f1f5f9;
            --line: #e2e8f0;
            --muted: #64748b;
            --danger: #b42318;
            --ok: #15803d;
            --paper: #ffffff;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            font-family: "IBM Plex Sans", "Segoe UI", Arial, sans-serif;
            color: var(--ink);
            background: var(--paper);
        }

        .page {
            display: grid;
            grid-template-columns: minmax(360px, 5fr) 6fr;
            min-height: 100%;
        }

        /* ---------- form side ---------- */
        .form-side {
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 48px clamp(24px, 7vw, 112px);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 56px;
            font-weight: 600;
        }

        .brand-mark {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            background: var(--accent);
            position: relative;
        }

            .brand-mark::after {
                content: "";
                position: absolute;
                left: 13px;
                top: 8px;
                width: 8px;
                height: 15px;
                border: solid #fff;
                border-width: 0 3px 3px 0;
                transform: rotate(45deg);
            }

        h1 {
            font-family: "Bricolage Grotesque", "Segoe UI", sans-serif;
            font-size: 2.5rem;
            line-height: 1.05;
            margin: 0 0 10px;
            letter-spacing: -0.02em;
        }

        .lead {
            margin: 0 0 32px;
            color: var(--muted);
            max-width: 38ch;
            line-height: 1.5;
        }

        .field {
            margin-bottom: 20px;
        }

        label {
            display: block;
            font-size: .875rem;
            font-weight: 500;
            margin-bottom: 6px;
        }

        .control {
            position: relative;
        }

        input[type=text], input[type=password] {
            width: 100%;
            height: 48px;
            padding: 0 14px;
            font: inherit;
            color: var(--ink);
            background: var(--field);
            border: 1px solid transparent;
            border-bottom: 2px solid var(--line);
            border-radius: 6px 6px 0 0;
            outline: none;
            transition: border-color .15s, background .15s;
        }

        input:focus {
            background: #fff;
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(37,99,235,.2);
        }

        .has-error input {
            border-bottom-color: var(--danger);
        }

        .field-error {
            display: block;
            margin-top: 6px;
            color: var(--danger);
            font-size: .8125rem;
        }

        .toggle {
            position: absolute;
            right: 6px;
            top: 6px;
            height: 36px;
            padding: 0 10px;
            border: 0;
            border-radius: 4px;
            background: transparent;
            color: var(--accent);
            font: inherit;
            font-size: .8125rem;
            font-weight: 600;
            cursor: pointer;
        }

            .toggle:hover {
                background: rgba(37,99,235,.08);
            }

            .toggle:focus-visible {
                outline: 2px solid var(--accent);
            }

        .row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin: 4px 0 28px;
        }

        .check {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: .875rem;
            margin: 0;
            font-weight: 400;
            cursor: pointer;
        }

            .check input {
                width: 18px;
                height: 18px;
                accent-color: var(--accent);
                margin: 0;
            }

        .row a {
            color: var(--accent);
            font-size: .875rem;
            font-weight: 500;
        }

        .btn {
            width: 100%;
            height: 50px;
            border: 0;
            border-radius: 6px;
            cursor: pointer;
            background: var(--accent);
            color: #fff;
            font: 600 1rem "IBM Plex Sans", sans-serif;
            transition: background .15s;
        }

            .btn:hover {
                background: var(--accent-dark);
            }

            .btn:focus-visible {
                outline: 3px solid var(--accent);
                outline-offset: 2px;
            }

            .btn[disabled] {
                opacity: .7;
                cursor: progress;
            }

        .alert {
            margin-bottom: 20px;
            padding: 12px 14px;
            border-radius: 6px;
            font-size: .9rem;
            background: #fdecea;
            color: var(--danger);
            border-left: 4px solid var(--danger);
        }

            .alert ul {
                margin: 0;
                padding-left: 18px;
            }

        .foot {
            margin-top: 48px;
            color: var(--muted);
            font-size: .8125rem;
        }

        /* ---------- permit slip side ---------- */
        .show-side {
            background: linear-gradient(160deg, #172b52 0%, var(--navy-deep) 70%);
            color: #e2e8f0;
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 48px;
        }

            .show-side::before {
                content: "";
                position: absolute;
                inset: 0;
                background: radial-gradient(circle at 15% 10%, rgba(59,130,246,.28), transparent 45%), radial-gradient(circle at 90% 95%, rgba(59,130,246,.16), transparent 40%);
            }

        .slip {
            position: relative;
            width: min(420px, 100%);
            background: #ffffff;
            color: var(--ink);
            border-radius: 10px;
            padding: 28px 28px 24px;
            box-shadow: 0 30px 60px rgba(0,0,0,.35);
        }

            .slip::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 6px;
                border-radius: 10px 10px 0 0;
                background: var(--accent);
            }

            .slip h2 {
                font-family: "Bricolage Grotesque", sans-serif;
                font-size: 1.35rem;
                margin: 6px 0 18px;
            }

            .slip dl {
                margin: 0;
                display: grid;
                grid-template-columns: 110px 1fr;
                row-gap: 12px;
                font-size: .9rem;
            }

            .slip dt {
                color: var(--muted);
            }

            .slip dd {
                margin: 0;
                font-weight: 500;
            }

        .stamp {
            display: inline-block;
            margin-top: 22px;
            padding: 6px 14px;
            border: 2px solid var(--ok);
            color: var(--ok);
            font-weight: 700;
            border-radius: 4px;
        }

        .tagline {
            position: absolute;
            left: 48px;
            bottom: 40px;
            right: 48px;
            font-size: 1.05rem;
            max-width: 36ch;
            color: #aebbd3;
        }

        @@media (max-width: 860px) {
            .page {
                grid-template-columns: 1fr;
            }

            .show-side {
                display: none;
            }

            .form-side {
                padding: 32px 24px;
            }
        }
    </style>
</head>
<body>
    <div class="page">

        <main class="form-side">
            <div class="brand"><span class="brand-mark" aria-hidden="true"></span>Permit Management</div>

            <h1>Sign in</h1>
            <p class="lead">Use your username and password. You can stay signed in on more than one device at the same time.</p>

            @using (Html.BeginForm("Login", "Account", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { novalidate = "novalidate", id = "loginForm" }))
            {
                @Html.AntiForgeryToken()

                if (!ViewData.ModelState.IsValid && ViewData.ModelState.Any(m => m.Key == "" && m.Value.Errors.Count > 0))
                {
                    <div class="alert" role="alert">@Html.ValidationSummary(true)</div>
                }

                <div class="field @(Html.ViewData.ModelState["Username"] != null && Html.ViewData.ModelState["Username"].Errors.Count > 0 ? "has-error" : "")">
                    @Html.LabelFor(m => m.Username)
                    @Html.TextBoxFor(m => m.Username, new { autocomplete = "username", autofocus = "autofocus", placeholder = "e.g. ADMIN001" })
                    @Html.ValidationMessageFor(m => m.Username, "", new { @class = "field-error" })
                </div>

                <div class="field @(Html.ViewData.ModelState["Password"] != null && Html.ViewData.ModelState["Password"].Errors.Count > 0 ? "has-error" : "")">
                    @Html.LabelFor(m => m.Password)
                    <div class="control">
                        @Html.PasswordFor(m => m.Password, new { autocomplete = "current-password" })
                        <button type="button" class="toggle" id="togglePwd" aria-controls="Password" aria-pressed="false">Show</button>
                    </div>
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-error" })
                </div>

                <div class="row">
                    <label class="check">@Html.CheckBoxFor(m => m.RememberMe) Keep me signed in</label>
                    <a href="@Url.Action("ForgotPassword", "Account")">Forgot password?</a>
                </div>

                <button type="submit" class="btn" id="submitBtn">Sign in</button>
            }

            <div class="foot">&copy; @DateTime.Now.Year Permit Management System</div>
        </main>

        <aside class="show-side" aria-hidden="true">
            <div class="slip">
                <h2>Permit to work</h2>
                <dl>
                    <dt>Permit no.</dt>
                    <dd>PTW-2041</dd>
                    <dt>Work type</dt>
                    <dd>Hot work, Boiler area</dd>
                    <dt>Department</dt>
                    <dd>Maintenance</dd>
                    <dt>Safety check</dt>
                    <dd>Completed</dd>
                </dl>
                <span class="stamp">APPROVED</span>
            </div>
            <p class="tagline">Request, approve and close work permits from one place.</p>
        </aside>

    </div>

    <script>
        (function () {
            var pwd = document.getElementById("Password");
            var btn = document.getElementById("togglePwd");
            btn.addEventListener("click", function () {
                var show = pwd.type === "password";
                pwd.type = show ? "text" : "password";
                btn.textContent = show ? "Hide" : "Show";
                btn.setAttribute("aria-pressed", show);
            });

            document.getElementById("loginForm").addEventListener("submit", function () {
                var b = document.getElementById("submitBtn");
                b.disabled = true; b.textContent = "Signing in...";
            });
        })();
    </script>
</body>
</html>
