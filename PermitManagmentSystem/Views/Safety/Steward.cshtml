@model PermitManagmentSystem.Models.DTOs.SafetyStewardDto
@{
    Layout = "~/Views/Shared/_SafetyLayout.cshtml";
    ViewBag.Title = "Safety Steward";
}

<a class="back" href="@Url.Action("Tasks", "Safety")">&larr; Back to work</a>

<div class="page-head">
    <div>
        <h1>Safety Steward</h1>
        <p>Permit @Model.PermitNo &middot; @Model.DepartmentName</p>
    </div>
</div>

@using (Html.BeginForm("Steward", "Safety", FormMethod.Post, new { novalidate = "novalidate" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.TaskId)

    <div class="form-shell">
        <aside class="form-aside">
            <h2>@(Model.IsEdit ? "Update the steward" : "Add the steward")</h2>
            <p>Review the permit and the work the department has set up, then record the Safety Steward for this job.</p>
            <ul>
                <li>One Safety Steward per job</li>
                <li>You can come back and edit later</li>
            </ul>
        </aside>

        <div class="form-main">
            <section class="fsec">
                <h3>Permit details</h3>
                <p class="fsub">Issued by Operation. Read only.</p>
                <dl class="info">
                    <div>
                    <dt>Permit no</dt>
                    <dd>@Model.PermitNo</dd>
        </div>
        <div><dt>Issue date</dt><dd>@Model.IssueDate.ToString("dd MMM yyyy")</dd></div>
        <div><dt>Work location</dt><dd>@Model.WorkLocation</dd></div>
        <div><dt>Department</dt><dd>@Model.DepartmentName</dd></div>
        <div><dt>Permit issued by</dt><dd>@Model.PermitIssueBy</dd></div>
        <div><dt>Permit issued to</dt><dd>@Model.PermitIssueTo</dd></div>
        <div class="full"><dt>Description</dt><dd>@Model.Description</dd></div>
        <div class="full">
            <dt>Document</dt>
            <dd>
                @if (Model.AttachmentFileName != null)
                {
                    <a class="file" href="@Url.Action("Download", "Safety", new { id = Model.PermitId })">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5" /></svg>
                        <span>@Model.AttachmentFileName</span>
                    </a>
                }
                else
                {
                    <span class="muted">No document attached</span>
                }
            </dd>
        </div>
        </dl>
        </section>

        <section class="fsec">
            <h3>Work set up by the department</h3>
            <p class="fsub">Read only.</p>
            <dl class="info">
                <div>
                <dt>Supervisor</dt>
                <dd>@Model.SupervisorName</dd>
    </div>
    <div><dt>Work dates</dt><dd>@Model.WorkStartDate.ToString("dd MMM yyyy") &ndash; @Model.ExpectedEndDate.ToString("dd MMM yyyy")</dd></div>
    <div class="full">
        <dt>Workers (pass no)</dt>
        <dd>
            <div class="chips">
                @foreach (var pass in Model.WorkerPassNos)
                {<span class="chip">@pass</span>}
            </div>
        </dd>
    </div>
    </dl>
    </section>

    <section class="fsec">
        <h3>Safety</h3>
        <p class="fsub">Who is the Safety Steward for this job.</p>
        <div class="fields">
            <div class="f full">
                @Html.LabelFor(m => m.SafetyStewardName)
                @Html.TextBoxFor(m => m.SafetyStewardName, new { maxlength = 150, autocomplete = "off" })
                @Html.ValidationMessageFor(m => m.SafetyStewardName, "", new { @class = "err" })
            </div>
        </div>
    </section>

    <div class="form-actions">
        <a class="btn btn-ghost" href="@Url.Action("Tasks", "Safety")">Cancel</a>
        <button type="submit" class="btn">Save</button>
    </div>
    </div>
    </div>
}
