@model PermitManagmentSystem.Models.DTOs.SafetyTaskListDto
@{
    Layout = "~/Views/Shared/_SafetyLayout.cshtml";
    ViewBag.Title = "Work";
}

<div class="page-head">
    <div>
        <h1>Work from departments</h1>
        <p>Every job a department has saved, across all departments.</p>
    </div>
</div>

<form class="toolbar" method="get" action="@Url.Action("Tasks", "Safety")">
    <div class="search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
        <input type="search" name="q" value="@Model.Query" placeholder="Search permit no, location, supervisor or steward" aria-label="Search work" />
    </div>
    <div class="size-pick">
        <label for="status">Status</label>
        <select id="status" name="status" onchange="this.form.submit()">
            <option value="" selected="@(string.IsNullOrEmpty(Model.Status))">All</option>
            <option value="pending" selected="@(Model.Status == "pending")">Awaiting steward</option>
            <option value="done" selected="@(Model.Status == "done")">Steward assigned</option>
        </select>
    </div>
    <button class="btn" type="submit">Search</button>
</form>

@if (!Model.Items.Any())
{
    <div class="table-wrap"><div class="empty"><h2>No work found</h2><p>Try a different search or status.</p></div></div>
}
else
{
    <div class="table-wrap">
        <table class="table-fixed cards">
            <colgroup>
                <col style="width:10%" />
                <col style="width:13%" />
                <col style="width:15%" />
                <col style="width:13%" />
                <col style="width:10%" />
                <col style="width:29%" />
                <col style="width:10%" />
            </colgroup>
            <thead><tr><th>Permit no</th><th>Department</th><th>Work location</th><th>Supervisor</th><th>Expected end</th><th>Safety Steward</th><th></th></tr></thead>
            <tbody>
                @foreach (var t in Model.Items)
                {
                    <tr>
                        <td class="no" data-label="Permit no">@t.PermitNo</td>
                        <td data-label="Department">@t.DepartmentName</td>
                        <td data-label="Work location">@t.WorkLocation</td>
                        <td data-label="Supervisor">@t.SupervisorName</td>
                        <td class="date" data-label="Expected end">@t.ExpectedEndDate.ToString("dd MMM yyyy")</td>
                        <td>
                            <form method="post" action="@Url.Action("AssignSteward", "Safety")" class="assign-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="taskId" value="@t.TaskId" />
                                <input type="hidden" name="returnTo" value="tasks" />
                                <input type="hidden" name="q" value="@Model.Query" />
                                <input type="hidden" name="status" value="@Model.Status" />
                                <input type="text" name="steward" value="@t.SafetyStewardName" maxlength="150" placeholder="Safety Steward" aria-label="Safety Steward for @t.PermitNo" autocomplete="off" />
                                <button type="submit" class="btn btn-sm">@(t.HasSteward ? "Update" : "Save")</button>
                            </form>
                        </td>
                        <td class="act"><a class="act-btn" href="@Url.Action("Steward", "Safety", new { id = t.TaskId })">Details</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="hint">Showing the latest @Model.Items.Count jobs. Use search to narrow the list.</p>
}
