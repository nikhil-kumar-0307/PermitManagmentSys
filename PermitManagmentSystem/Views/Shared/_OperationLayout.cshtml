@{
    var controller = (string)ViewContext.RouteData.Values["controller"];
    var action = (string)ViewContext.RouteData.Values["action"];
    var onDashboard = controller == "Operation";
    var onList = controller == "Permits" && action == "Index";
    var onForm = controller == "Permits" && (action == "Create" || action == "Edit");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - Permit Management</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="~/Content/operation.css" rel="stylesheet" />
</head>
<body>
    <header class="topbar">
        <div class="topbar-in">
            <a class="brand" href="@Url.Action("Dashboard", "Operation")">
                <span class="brand-mark" aria-hidden="true"></span>Permit Management
            </a>

            <nav class="nav" aria-label="Main">
                <a href="@Url.Action("Dashboard", "Operation")" class="@(onDashboard ? "on" : "")">Dashboard</a>
                <a href="@Url.Action("Index", "Permits")" class="@(onList ? "on" : "")">All permits</a>
                <a href="@Url.Action("Create", "Permits")" class="@(onForm ? "on" : "")">Add permit</a>
            </nav>

            <div class="who">
                <span class="who-name">@User.Identity.Name</span>
                <span class="who-role">Operation</span>
                @using (Html.BeginForm("Logout", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="link-btn">Sign out</button>
                }
            </div>
        </div>
    </header>

    <main class="main">
        @if (TempData["Success"] != null)
        {
            <div class="flash" role="status">@TempData["Success"]</div>
        }

        @RenderBody()
    </main>

    <script>
        // Attachment drop zone on the Add / Edit permit pages
        (function () {
            var drop = document.getElementById("drop");
            if (!drop) return;
            var input = document.getElementById("Attachment");
            var title = document.getElementById("dropTitle");
            var sub = document.getElementById("dropSub");
            var t0 = title.textContent, s0 = sub.textContent;

            function show() {
                if (input.files && input.files.length) {
                    var f = input.files[0];
                    title.textContent = f.name;
                    sub.textContent = (f.size / 1024 / 1024).toFixed(2) + " MB. Click to choose a different file.";
                } else {
                    title.textContent = t0;
                    sub.textContent = s0;
                }
            }
            input.addEventListener("change", show);
            ["dragenter", "dragover"].forEach(function (e) {
                drop.addEventListener(e, function () { drop.classList.add("over"); });
            });
            ["dragleave", "drop"].forEach(function (e) {
                drop.addEventListener(e, function () { drop.classList.remove("over"); });
            });
        })();
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
