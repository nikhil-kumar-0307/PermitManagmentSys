@model PermitManagmentSystem.Models.DTOs.PermitDto
@{
    Layout = "~/Views/Shared/_OperationLayout.cshtml";
    ViewBag.Title = "Edit permit";
}

<a class="back" href="@Url.Action("Index", "Permits")">Back to all permits</a>

<div class="page-head">
    <div>
        <h1>Edit permit</h1>
        <p>@Model.PermitNo</p>
    </div>
</div>

@using (Html.BeginForm("Edit", "Permits", new { id = Model.Id }, FormMethod.Post, new { enctype = "multipart/form-data", novalidate = "novalidate" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.ExistingFileName)

    <div class="form-shell">
        <aside class="form-aside">
            <h2>Update permit</h2>
            <p>Change any detail and save. Your changes apply to this permit only.</p>
            <ul>
                <li>Choose a new file to replace the current document.</li>
                <li>Tick "Remove this file" to delete it without a replacement.</li>
                <li>Older permits may need a department selected before saving.</li>
            </ul>
        </aside>

        <div class="form-main">
            @Html.Partial("_PermitFields", Model)

            <div class="form-actions">
                <a class="btn btn-ghost" href="@Url.Action("Index", "Permits")">Cancel</a>
                <button type="submit" class="btn">Save changes</button>
            </div>
        </div>
    </div>
}
